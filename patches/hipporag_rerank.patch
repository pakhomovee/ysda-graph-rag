+def _doc_strings(corpus):
+    """The passage identity used everywhere in this repo.
+
+    Upstream builds `docs` this way too, and mbuzai.dataio.Dataset.docs is the same
+    expression over the same file, so a retrieved doc string maps to our pid by plain
+    dict lookup. Anything that re-chunks or re-serialises breaks that into -1s.
+    """
+    return [f"{doc['title']}\n{doc['text']}" for doc in corpus]
+
+
+def export_facts(rag, queries, qids, gold_pids, path, pool_k):
+    """Dump the fact-selection decision for every question, for offline training.
+
+    Labels come from `rag.proc_triples_to_docs` (built in prepare_retrieval_objects):
+    processed-triple string -> the set of chunk ids it was extracted from. A candidate
+    fact is positive when any of its source chunks is a gold passage. That mapping is
+    the only thing that makes this trainable, so it is asserted non-empty rather than
+    silently producing an all-zero label column.
+
+    Raw dots are stored alongside the min-max score, with each query's global min/max,
+    so a shuffle control can recompute the score a RECIPIENT query would have given a
+    donor's candidate list. Reusing the donor's score there would leak the donor's
+    labels straight into the control and make it pass for the wrong reason.
+
+    Embeddings are stored AS THE STORE HOLDS THEM: HippoRAG's
+    TransformersEmbeddingModel.batch_encode drops its kwargs, so nothing in the index
+    is L2-normalised. Normalisation happens in exactly one place, in the feature
+    builder, rather than being half-applied here.
+    """
+    import numpy as np
+
+    rag.prepare_retrieval_objects()
+    if not getattr(rag, "proc_triples_to_docs", None):
+        raise SystemExit(
+            "\nFATAL: proc_triples_to_docs is empty — no fact can be traced to a source\n"
+            "  passage, so every label would be 0. The OpenIE results are missing or the\n"
+            "  index was built by a different code path."
+        )
+    chunk_key_to_pid = {k: rag._our_pid_of.get(
+        rag.chunk_embedding_store.get_row(k)["content"], -1) for k in rag.passage_node_keys}
+
+    # fact row -> source pids, resolved once. Coverage is reported because every label
+    # rests on it: if facts cannot be traced to passages, the labels are all zero and
+    # the training run would look merely unsuccessful rather than broken.
+    fact_src = []
+    n_traced = 0
+    for key in rag.fact_node_keys:
+        content = rag.fact_embedding_store.get_row(key)["content"]
+        srcs = {chunk_key_to_pid.get(c, -1) for c in rag.proc_triples_to_docs.get(content, ())}
+        srcs.discard(-1)
+        n_traced += bool(srcs)
+        fact_src.append(srcs)
+    cover = n_traced / max(len(fact_src), 1)
+    print(f"fact -> passage coverage: {n_traced}/{len(fact_src)} ({cover:.3f})")
+    if cover < 0.98:
+        raise SystemExit(
+            f"\nFATAL: only {cover:.1%} of facts trace back to a source passage.\n"
+            "  Labels built on that would be mostly false negatives. Check that the fact\n"
+            "  store content and proc_triples_to_docs keys are the same string form."
+        )
+
+    rag.get_query_embeddings(queries)
+    F = np.asarray(rag.fact_embeddings, dtype=np.float32)
+    n_q = len(queries)
+    cand_idx = np.full((n_q, pool_k), -1, dtype=np.int64)
+    cand_score = np.zeros((n_q, pool_k), dtype=np.float32)
+    cand_raw = np.zeros((n_q, pool_k), dtype=np.float32)
+    cand_nsrc = np.zeros((n_q, pool_k), dtype=np.int32)
+    label = np.zeros((n_q, pool_k), dtype=np.int8)
+    raw_min = np.zeros(n_q, dtype=np.float32)
+    raw_max = np.zeros(n_q, dtype=np.float32)
+    query_emb = np.zeros((n_q, F.shape[1]), dtype=np.float32)
+    ceiling = np.zeros(n_q, dtype=np.int8)
+
+    for i, query in enumerate(queries):
+        hq = np.asarray(rag.query_to_embedding["triple"][query], dtype=np.float32).ravel()
+        query_emb[i] = hq
+        raw = F @ hq
+        raw_min[i], raw_max[i] = float(raw.min()), float(raw.max())
+        take = min(pool_k, len(raw))
+        top = np.argsort(raw)[-take:][::-1]
+        span = (raw_max[i] - raw_min[i]) or 1.0
+        cand_idx[i, :take] = top
+        cand_raw[i, :take] = raw[top]
+        cand_score[i, :take] = (raw[top] - raw_min[i]) / span
+        gold = gold_pids[i]
+        for j, fi in enumerate(top):
+            srcs = fact_src[fi]
+            cand_nsrc[i, j] = len(srcs)
+            if srcs & gold:
+                label[i, j] = 1
+        ceiling[i] = int(label[i].any())
+
+    np.savez_compressed(
+        path,
+        qids=np.array(qids), query_emb=query_emb,
+        fact_emb=F, cand_idx=cand_idx, cand_score=cand_score, cand_raw=cand_raw,
+        cand_nsrc=cand_nsrc, label=label, raw_min=raw_min, raw_max=raw_max,
+    )
+    pos = int(label.sum())
+    print(f"wrote {path}: {n_q} questions x {pool_k} candidates, "
+          f"{pos} positives ({pos / max(n_q, 1):.1f} per question)")
+    # THE decisive number: no reranker can retrieve a gold-attested fact that is not in
+    # the pool, so this is the ceiling on every arm at this site, learned or LLM.
+    print(f"candidate ceiling @{pool_k}: {int(ceiling.sum())}/{n_q} "
+          f"({ceiling.mean():.3f}) questions have >=1 gold-attested fact in the pool")
+    for k in (5, 10, 25, 50):
+        if k < pool_k:
+            c = (label[:, :k].sum(1) > 0).mean()
+            print(f"  ceiling @{k:>3}: {c:.3f}")
+
+
