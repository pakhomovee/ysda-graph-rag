+    def _path_rows(self, q_set, tier):
+        """The rows of the query set appropriate to THIS hop.
+
+        A decomposition is a chain, and sigma_max over the whole set discards the
+        order: an expansion whose sentences match sub-question 1 scores exactly
+        like one that advances from sub-question 1 to 2. Gating a tier-t
+        expansion by sub-question t makes the search follow the decomposition
+        rather than treating it as a bag.
+
+        Row 0 is the original question and is always kept, so sigma_max >=
+        sigma_q still holds elementwise and the arm cannot fall below vanilla by
+        construction — the stage-appropriate sub-question is added, not
+        substituted.
+        """
+        m = q_set.shape[0]
+        if m < 2:
+            return q_set
+        idx = min(max(int(tier), 1), m - 1)
+        w = int(getattr(self.config, "path_window", 0))
+        lo, hi = max(1, idx - w), min(m - 1, idx + w)
+        return q_set[[0] + list(range(lo, hi + 1))]
