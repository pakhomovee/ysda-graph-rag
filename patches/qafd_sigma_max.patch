+def _load_normalize_question(sidecar_path: str):
+    """mbuzai.subq_io.normalize_question, importing mbuzai the same way the
+    retriever's sub-question loader does.
+
+    Every sidecar in out/ is keyed by the normalised question, so the oracle file
+    has to be read with the exact same function — a second implementation here
+    would drift and silently miss questions, which this probe reads as "the
+    oracle did nothing".
+    """
+    try:
+        from mbuzai.subq_io import normalize_question
+    except ImportError:
+        # The exporters write to <repo>/out/, so the checkout root is two levels
+        # up from the sidecar. Same fallback as retriever._query_set.
+        from pathlib import Path as _Path
+        _root = _Path(sidecar_path).resolve().parent.parent
+        if str(_root) not in sys.path:
+            sys.path.insert(0, str(_root))
+        try:
+            from mbuzai.subq_io import normalize_question
+        except ImportError as _exc:
+            raise ImportError(
+                f"cannot import mbuzai from {_root}; set PYTHONPATH=/path/to/mbuzai-rag"
+            ) from _exc
+    return normalize_question
+
