+"""Generic sentence-transformers encoder for QAFD-RAG.
+
+Added so QAFD can run on the SAME encoder as the rest of the comparison
+(all-mpnet-base-v2). Their registry ships NV-Embed-v2 (7B), GritLM (7B), Jina-v3
+and OpenAI; running any of those against baselines built on mpnet (110M) compares
+encoders rather than retrieval methods, and the encoder is worth far more than
+the intervention under test.
+
+Instruction kwargs are accepted and ignored, exactly as JinaV3 does — mpnet is
+not an instruction-tuned encoder.
+"""
+
+from typing import List, Optional
+import logging
+import os
+
+import numpy as np
+
+logger = logging.getLogger(__name__)
+
+
+class STEmbeddingModel:
+    """Any sentence-transformers checkpoint, by name."""
+
+    def __init__(self, global_config, embedding_model_name: Optional[str] = None):
+        self.global_config = global_config
+        self.embedding_model_name = (
+            embedding_model_name or global_config.embedding_model_name
+        )
+        from sentence_transformers import SentenceTransformer
+
+        # SentenceTransformer grabs CUDA whenever it is visible. At retrieval time
+        # this encoder only ever encodes the queries — passage/entity/fact vectors
+        # come from the cached index — so a few thousand short strings, which CPU
+        # handles in seconds. That matters when several arms run concurrently
+        # against a box whose GPU is already fully committed to vLLM: N copies of
+        # mpnet competing for the leftover VRAM is the one way this OOMs.
+        #
+        #     MBUZAI_ST_DEVICE=cpu    keep the GPU entirely for vLLM
+        #     unset                   sentence-transformers' own default (CUDA if present)
+        _device = os.environ.get("MBUZAI_ST_DEVICE") or None
+        logger.info(f"Initializing sentence-transformers: {self.embedding_model_name}"
+                    f"{f' on {_device}' if _device else ''}")
+        self.embedding_model = SentenceTransformer(self.embedding_model_name, device=_device)
+        self.embedding_dim = self.embedding_model.get_sentence_embedding_dimension()
+        self.batch_size = getattr(global_config, "embedding_batch_size", 32)
+        self.normalize = getattr(global_config, "embedding_return_as_normalized", True)
+        logger.info(f"loaded {self.embedding_model_name}: {self.embedding_dim}-dim")
+
+    def batch_encode(self, texts: List[str], **kwargs) -> np.ndarray:
+        if isinstance(texts, str):
+            texts = [texts]
+        return self.embedding_model.encode(
+            texts,
+            batch_size=kwargs.get("batch_size", self.batch_size),
+            convert_to_numpy=True,
+            show_progress_bar=False,
+            normalize_embeddings=kwargs.get("norm", self.normalize),
+        )
